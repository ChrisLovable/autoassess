# ============================================================
# AutoAssess — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local — it's in .gitignore.
# ============================================================

# ----- Supabase (required) -----
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- Anthropic Claude (required for AI analysis) -----
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ----- App config -----
APP_ID_SALT=replace-with-long-random-string-for-popia-id-hashing
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Optional: messaging (Phase 2) -----
# SendGrid for email
SENDGRID_API_KEY=
# WhatsApp Business API provider (BSP)
WHATSAPP_BSP_KEY=
WHATSAPP_BSP_PHONE_NUMBER_ID=

# ----- Optional: payments (Phase 3) -----
# DPO Pay for ZAR
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
# Paddle for international
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ----- Optional: monitoring -----
SENTRY_DSN=
